# E2E Test Environment for the jupyterlab template (tf-aws-ec2-jupyterlab)
#
# The jupyterlab template has no required variables and no browser sign-in —
# access is authorized by the caller's AWS identity, not by GitHub OAuth / user /
# team / org. Domain, subdomain, email, OAuth-app, and user/team/org env vars are
# intentionally absent.
#
# Copy to <repo-root>/.env if you want to override the container build defaults.

# ==============================================================================
# TEST CONTAINER BUILD CONFIGURATION
# ==============================================================================

# Leave blank — the justfile populates them automatically
HOST_UID=
HOST_GID=
E2E_DOCKERFILE=

# ==============================================================================
# MUTATING-PASS CONFIGURATION
# ==============================================================================
# The only test env vars this template needs. The mutating pass switches ONE live
# deployment between these two instance types in place (that transition is the
# coverage — see tests/e2e/constants.py), and changes the log retention to prove a
# non-instance variable applies in the same `jd up`.
#
# Note log_files_retention_days rather than volume_size_gb: AWS enforces a 6-hour
# cooldown between EBS volume modifications, so a volume resize cannot be re-run.

JD_E2E_CPU_INSTANCE=t3.medium
# g5 rather than g6: the templates pin the instance to `subnet_ids[0]` of the default VPC, so the
# GPU swap can only ever be attempted in that one AZ. On 2026-09-15 g6.xlarge was refused there in
# both accounts we run in — us-west-2c (dev) and us-west-2d (CI), 0/4 attempts, ~52min of provider
# retries per attempt — while g5.xlarge got capacity in about a minute. Revisit once the AZ is
# selectable rather than positional (jupyter-deploy#374).
JD_E2E_GPU_INSTANCE=g5.xlarge
JD_E2E_LARGER_LOG_RETENTION_DAYS=365
